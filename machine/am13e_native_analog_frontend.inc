static void am13e_native_motor_publish(AM13ENativeMotor *m)
{
    const double offs[3] = {0.0, -2.0*AM13E_NATIVE_PI/3.0,
                            2.0*AM13E_NATIVE_PI/3.0};
    uint32_t words[3];
    for (int p = 0; p < 3; p++) {
        double bemf = AM13E_NATIVE_K_FLUX*m->omega*
                      am13e_native_flux_basis(m,m->theta+offs[p]);
        double voltage = 1.65+0.02*bemf;
        if (!isfinite(voltage) || voltage < 0.0 || voltage > 3.3) {
            am13e_native_motor_fault(m, 3U);
            return; /* NO silent analog saturation/clipping. */
        }
        int64_t code_signed=(int64_t)llround(4095.0*voltage/3.3);
        int noise_code=0;
        if (m->bemf_stress_switch_code &&
            m->bemf_stress_last_switch_ns >= 0) {
            int64_t elapsed=qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)-
                            m->bemf_stress_last_switch_ns;
            if (elapsed >= 0 && elapsed < INT64_C(2000)) {
                noise_code=(m->bemf_stress_switch_edges & 1U) ?
                    (int)m->bemf_stress_switch_code :
                    -(int)m->bemf_stress_switch_code;
            }
        }
        int64_t original_code=code_signed;
        code_signed += (int64_t)m->bemf_stress_offset_code + noise_code;
        /* Sensor out of 12-bit range is a FAIL-CLOSED model error;
         * never silently saturate a forbidden value into a good CAP1. */
        if (code_signed < 0 || code_signed > 4095) {
            am13e_native_motor_fault(m, 3U);
            return;
        }
        uint32_t code=(uint32_t)code_signed;
        if (m->bemf_stress_trace_count < 36U &&
            (noise_code || (m->bemf_stress_offset_code &&
                            m->bemf_stress_trace_count < 3U))) {
            /* Diagnostics intentionally OUTSIDE strict E62_P0_EVENT stream:
             * the immutable P1 event schema must remain untouched. */
            error_report("E62_BEMF_STRESS_DIAG vns=%lld a=%d b=%lld "
                         "c=%u d=%d e=%d f=%u",
                         (long long)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
                         p,(long long)original_code,code,
                         m->bemf_stress_offset_code,noise_code,
                         m->bemf_stress_switch_edges);
            ++m->bemf_stress_trace_count;
        }
        if (code > 4095U) {
            am13e_native_motor_fault(m, 3U);
            return;
        }
        words[p] = 0x10000U | code;
        m->bemf_codes[p] = code;
    }
    uint32_t changed = 0U;
    if (!am13e_g10_stim_vector(&m->machine->feedback, words, &changed)) {
        am13e_native_motor_fault(m, 4U);
        return;
    }
    m->analog_updates += changed;
}
/* Real motor state drives the simulated physical overcurrent inputs.
 * QEMU trip comparator channels n=0/1/2 select W/V/U respectively.
 * Earlier host tests supplied code 1000 as an external zero-current
 * fixture. Native mode instead uses 1000 + 4*abs(I_phase[A]): a
 * deliberately UNCALIBRATED SIM_ONLY sensing assumption. The original
 * CMPSS route, DAC limit, Trip and OST logic remain fully active.
 * Never saturate an unrepresentable reading into a healthy code.
 */
static void am13e_native_motor_publish_oc(AM13ENativeMotor *m)
{
    AM13EMachineState *s = m->machine;
    const unsigned phase_for_oc[3] = {2U, 1U, 0U};
    uint16_t code[3];
    for (unsigned n = 0; n < 3U; ++n) {
        double raw = 1000.0 + 4.0*fabs(m->currents[phase_for_oc[n]]);
        if (!isfinite(raw) || raw > 4095.0) {
            am13e_native_motor_fault(m, 6U);
            return;
        }
        code[n] = (uint16_t)lround(raw);
        /* Deliberate EXTERNAL current-sense overrange experiment, not a
         * physical overcurrent generated by this uncalibrated plant.
         * No Guest PWM, Trip, CMPSS, IRQ or internal motor state writes.
         * It is effective only while the source calendar is active,
         * and is disjoint from the default native OC source behavior.
         */
        if (s->auto_sitl.p1_oc_enable && s->auto_sitl.p1_oc_active &&
            s->auto_sitl.p1_oc_channel == n)
            code[n] = 4095U;
    }
    for (unsigned n = 0; n < 3U; ++n) {
        s->trip.oc_input[n] = code[n];
        s->trip.oc_valid[n] = true;
    }
    ++m->oc_publications;
    am13e_g13b2_trip_update(s);
}

